# Copia in .env.local (sviluppo) o inseriscile su Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://oduqbzifwhrunwunuvkl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<la publishable key del progetto>
# Opzionale: indirizzo pubblico del sito (se vuoto si ricava dalla richiesta).
# NEXT_PUBLIC_SITE_URL=https://schoolos.vercel.app
# Solo piano Pro / AI (lasciare vuoto finché non serve):
# ANTHROPIC_API_KEY=
# Assistente (chat di aiuto, solo piano Pro). Spento finché non metti true; serve anche ANTHROPIC_API_KEY.
# ASSISTANT_AI_ENABLED=true
# Facoltativo, default claude-haiku-4-5:
# ASSISTANT_MODEL=

# CAPTCHA anti-bot (Cloudflare Turnstile): chiave PUBBLICA del sito. Se manca, il CAPTCHA non appare.
# Attivarlo anche su Supabase (Authentication → Attack Protection) solo DOPO aver messo questa e rifatto il deploy.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
