{
  "manifest_version": 3,
  "name": "SchoolOS · Importa voti",
  "version": "0.4.0",
  "description": "Legge la pagina voti del registro e li porta in SchoolOS. Nessuna password, nessun server intermedio.",
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Importa in SchoolOS",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://oduqbzifwhrunwunuvkl.supabase.co/*",
    "https://*.axioscloud.it/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.axioscloud.it/*"
      ],
      "js": [
        "axios.js",
        "content-axios.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
